<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ExiledVersion>9.15.3</ExiledVersion>
    <ReferencesPath Condition="'$(ReferencesPath)' == ''">$(MSBuildThisFileDirectory).build/references</ReferencesPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Brainless.Tests'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp" HintPath="$(ReferencesPath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ReferencesPath)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(ReferencesPath)/CommandSystem.Core.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(ReferencesPath)/Mirror.dll" Private="false" />
    <Reference Include="LabApi" HintPath="$(ReferencesPath)/LabApi.dll" Private="false" />
    <Reference Include="Pooling" HintPath="$(ReferencesPath)/Pooling.dll" Private="false" />
    <Reference Include="NorthwoodLib" HintPath="$(ReferencesPath)/NorthwoodLib.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ReferencesPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ReferencesPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ReferencesPath)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ReferencesPath)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ReferencesPath)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ReferencesPath)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="Exiled.API" HintPath="$(ReferencesPath)/Exiled.API.dll" Private="false" />
    <Reference Include="Exiled.Events" HintPath="$(ReferencesPath)/Exiled.Events.dll" Private="false" />
    <Reference Include="Exiled.Loader" HintPath="$(ReferencesPath)/Exiled.Loader.dll" Private="false" />
    <Reference Include="Exiled.Permissions" HintPath="$(ReferencesPath)/Exiled.Permissions.dll" Private="false" />
    <Reference Include="Exiled.CustomItems" HintPath="$(ReferencesPath)/Exiled.CustomItems.dll" Private="false" />
    <Reference Include="YamlDotNet" HintPath="$(ReferencesPath)/YamlDotNet.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(ReferencesPath)/0Harmony.dll" Private="false" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/GameplayText.cs" Link="Internal/GameplayText.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons' Or '$(MSBuildProjectName)' == 'Brainless.Roles'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/SupRules.cs" Link="Internal/SupRules.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Rules.cs" Link="Internal/Rules.cs" Condition="'$(MSBuildProjectName)' != 'Brainless.ScpProxChat'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ExplosionRules.cs" Link="Internal/ExplosionRules.cs" Condition="'$(MSBuildProjectName)' != 'Brainless.ScpProxChat'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Runtime.cs" Link="Internal/Runtime.cs" Condition="'$(MSBuildProjectName)' != 'Brainless.ScpProxChat'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Tuning.cs" Link="Internal/Tuning.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons' Or '$(MSBuildProjectName)' == 'Brainless.Roles' Or '$(MSBuildProjectName)' == 'Brainless.RoundEvents'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Updates/*.cs" Link="Internal/Updates/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/AudioRules.cs" Link="Internal/AudioRules.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RoleMarkers.cs" Link="Internal/RoleMarkers.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Roles' Or '$(MSBuildProjectName)' == 'Brainless.SlFixes'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Native914.cs" Link="Internal/Native914.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Roles' Or '$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigReload.cs" Link="Internal/ConfigReload.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.ScpProxChat'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigDocument.cs" Link="Internal/ConfigDocument.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons' Or '$(MSBuildProjectName)' == 'Brainless.Roles' Or '$(MSBuildProjectName)' == 'Brainless.ScpProxChat' Or '$(MSBuildProjectName)' == 'Brainless.Coinflips'" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigMigration.cs" Link="Internal/ConfigMigration.cs" Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons' Or '$(MSBuildProjectName)' == 'Brainless.Roles' Or '$(MSBuildProjectName)' == 'Brainless.ScpProxChat' Or '$(MSBuildProjectName)' == 'Brainless.Coinflips'" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ItemFiles.cs" Link="Internal/ItemFiles.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/AdminItems.cs" Link="Internal/AdminItems.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/DistributionRules.cs" Link="Internal/DistributionRules.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/DistributionConfig.cs" Link="Internal/DistributionConfig.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/NaturalDistribution.cs" Link="Internal/NaturalDistribution.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/EffectAudioTuning.cs" Link="Internal/EffectAudioTuning.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CursedLoot.cs" Link="Internal/CursedLoot.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.Items' Or '$(MSBuildProjectName)' == 'Brainless.Weapons' Or '$(MSBuildProjectName)' == 'Brainless.Roles'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/FragProjectiles.cs" Link="Internal/FragProjectiles.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Rarity.cs" Link="Internal/Rarity.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigReload.cs" Link="Internal/ConfigReload.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.RoundEvents'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigReload.cs" Link="Internal/ConfigReload.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.Coinflips' Or '$(MSBuildProjectName)' == 'Brainless.ScpSwap' Or '$(MSBuildProjectName)' == 'Brainless.ZombieOptOut'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RolesBridge.cs" Link="Internal/RolesBridge.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.ZombieOptOut'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CoreBridge.cs" Link="Internal/CoreBridge.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Brainless.SlFixes'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CoreBridge.cs" Link="Internal/CoreBridge.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ConfigReload.cs" Link="Internal/ConfigReload.cs" />
  </ItemGroup>
  <Target Name="CheckPluginReferences" BeforeTargets="ResolveReferences" Condition="'$(TargetFramework)' == 'net48'">
    <Error Condition="!Exists('$(ReferencesPath)/Exiled.API.dll')" Text="Run python3 scripts/fetch_references.py first, or set ReferencesPath to your matching EXILED and game assemblies." />
  </Target>
</Project>
